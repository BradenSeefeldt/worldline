{
  "name": "worldline",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app": "tauri dev --config '{\"identifier\":\"io.github.bradenseefeldt.worldline.dev\",\"productName\":\"Worldline Dev\"}'",
    "app:build": "tauri build --bundles app",
    "app:package": "tauri build --bundles app && bash scripts/make-dmg.sh",
    "build:guest": "vite build --config vite.guest.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:site": "vite preview --config vite.guest.config.ts --port 4175 --strictPort --host",
    "preview:web": "vite preview --config vite.web.config.ts --port 4174 --strictPort --host",
    "test:perf": "PERF=1 TZ=America/Toronto vitest run src/perf --silent=false"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@noble/hashes": "2.0.1",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-autostart": "2.6.0",
    "@tauri-apps/plugin-notification": "2.5.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "chrono-node": "^2.10.2",
    "city-timezones": "^1.3.4",
    "date-fns": "^4.4.0",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "idb-keyval": "6.3.0",
    "jsqr": "1.4.0",
    "katex": "0.18.11",
    "lowlight": "3.3.0",
    "nostr-tools": "2.25.2",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "2.8.1",
    "yjs": "13.6.33",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
