{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Worldline",
  "version": "0.8.0",
  "identifier": "io.github.bradenseefeldt.worldline",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worldline",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost wss: https://bradenseefeldt.github.io; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Your calendar, habits and research projects \u2014 on your Mac, offline",
    "copyright": "Free to use",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCRjAyRTBEM0JGOThEQkEKUldTNmpmazdEUzd3Ty9iYzhjSU1Jc3JnTXFKL1czaXZyY3JlN2ltN2NDMjlTUTFtN3RTNHBJeWMK",
      "endpoints": [
        "https://github.com/BradenSeefeldt/worldline/releases/latest/download/latest.json"
      ]
    }
  }
}
